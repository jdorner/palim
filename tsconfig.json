{
  "exclude": ["frontend", "portal", "node_modules"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@src/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@ext/sdk": ["./src/extensions/sdk.ts"],
      "@ext/types": ["./src/extensions/types.ts"],
      "@ext/ui": ["./src/extensions/ui/index.ts"],
      // Extension UI pages (src/extensions/*/ui/*.svelte): the public UI kit and its
      // internal $lib imports, as in the tsconfig generated for external extensions
      "@palim/ui": ["./frontend/src/lib/extensionKit.ts"],
      "$lib/*": ["./frontend/src/lib/*"],
      "$shared/*": ["./shared/*"],
      // Packages the extension UI builder provides from frontend/node_modules
      "phosphor-svelte/lib/*": ["./frontend/node_modules/phosphor-svelte/lib/*.svelte.d.ts"],
      "bits-ui": ["./frontend/node_modules/bits-ui/dist/index.d.ts"],
      "tailwind-merge": ["./frontend/node_modules/tailwind-merge/dist/types.d.ts"],
      "tailwind-variants": ["./frontend/node_modules/tailwind-variants/dist/index.d.ts"]
    }
  }
}
