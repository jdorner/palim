{
  // Solution config: editors and `tsc -b` pick the referenced project that
  // includes a file (app code vs. bun tests vs. vite config).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // `bun test` reads path aliases from this file only (it does not follow
  // references), so they are mirrored from tsconfig.app.json.
  "compilerOptions": {
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$shared": ["../shared"],
      "$shared/*": ["../shared/*"]
    }
  }
}
